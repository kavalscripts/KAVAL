-- Custom Jump Count Enforcer
local function applyCustomJumpCount(num)
	customJumpCount = num

	-- Disconnect old connection if existing
	if jumpAttributeConnection then
		jumpAttributeConnection:Disconnect()
		jumpAttributeConnection = nil
	end

	-- Set initial value
	player:SetAttribute("ExtraJumps", customJumpCount)

	-- Monitor changes and lock to the set value
	jumpAttributeConnection = player:GetAttributeChangedSignal("ExtraJumps"):Connect(function()
		if player:GetAttribute("ExtraJumps") ~= customJumpCount then
			player:SetAttribute("ExtraJumps", customJumpCount)
		end
	end)
end

-- Custom Speed Enforcer
local function applyCustomSpeed(speed)
	customWalkSpeed = speed

	if speedConnection then
		speedConnection:Disconnect()
		speedConnection = nil
	end

	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid")

	if humanoid then
		humanoid.WalkSpeed = customWalkSpeed
		speedConnection = humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if humanoid.WalkSpeed ~= customWalkSpeed then
				humanoid.WalkSpeed = customWalkSpeed
			end
		end)
	end
end

-- Re-apply Speed on Character Respawn
player.CharacterAdded:Connect(function(character)
	task.wait(0.5)
	if customWalkSpeed then
		applyCustomSpeed(customWalkSpeed)
	end
end)

