-- 8. Get XP - Smart Remote Discovery System
-- Executor function references
local _getgc = getgc or (debug and debug.getgc)
local _getupvalues = (debug and debug.getupvalues) or getupvalues
local _getconnections = getconnections or (debug and debug.getconnections)
local _getinfo = (debug and (debug.getinfo or debug.info))

-- Helper: get source string from a function
local function getFuncSource(func)
	if not debug or type(func) ~= "function" then return "" end
	if debug.getinfo then
		local ok, info = pcall(debug.getinfo, func)
		if ok and info then
			return tostring(info.short_src or info.source or "")
		end
	end
	if debug.info then
		local ok, src = pcall(debug.info, func, "s")
		if ok then return tostring(src or "") end
	end
	return ""
end

-- Cache for trampoline remote
local cachedTrampolineName = nil
local cachedRemote = nil

-- Smart search: find the correct RemoteEvent for a given trampoline name
local function findTrampolineRemote(trampName)
	if not trampName then return nil end

	local packages = ReplicatedStorage:FindFirstChild("Packages")
	if not packages then return nil end
	local netFolder = packages:FindFirstChild("Net")
	if not netFolder then return nil end

	-- Get the trampoline model and its Weld
	local mapFolder = workspace:FindFirstChild("Map")
	if not mapFolder then return nil end
	local baseTrampolines = mapFolder:FindFirstChild("BaseTrampolines")
	if not baseTrampolines then return nil end
	local tramp = baseTrampolines:FindFirstChild(trampName)
	if not tramp then return nil end
	local weld = tramp:FindFirstChild("Weld")
	if not weld then return nil end

	-- Collect all RemoteEvents in the Net folder
	local allRemotes = {}
	for _, d in ipairs(netFolder:GetDescendants()) do
		if d:IsA("RemoteEvent") then
			table.insert(allRemotes, d)
		end
	end
	if #allRemotes == 0 then return nil end

	-- Method 1: Search getgc for functions whose upvalues contain BOTH the trampoline Weld and a RemoteEvent
	if _getgc and _getupvalues then
		local gc = _getgc()
		local checked = 0
		for _, func in ipairs(gc) do
			if type(func) == "function" then
				checked = checked + 1
				if checked > 50000 then break end -- safety limit
				local ok, ups = pcall(_getupvalues, func)
				if ok and type(ups) == "table" then
					local foundWeld = false
					local foundRemote = nil
					for _, v in pairs(ups) do
						if v == weld then
							foundWeld = true
						elseif typeof(v) == "Instance" and v:IsA("RemoteEvent") and v:IsDescendantOf(netFolder) then
							foundRemote = v
						end
					end
					if foundWeld and foundRemote then
						print("[GetXP] Found remote via getgc Weld upvalue:", foundRemote.Name)
						return foundRemote
					end
				end
			end
		end
	end

	-- Method 2: Search getgc for functions whose upvalues contain BOTH the trampoline model and a RemoteEvent
	if _getgc and _getupvalues then
		local gc = _getgc()
		local checked = 0
		for _, func in ipairs(gc) do
			if type(func) == "function" then
				checked = checked + 1
				if checked > 50000 then break end
				local ok, ups = pcall(_getupvalues, func)
				if ok and type(ups) == "table" then
					local foundTramp = false
					local foundRemote = nil
					for _, v in pairs(ups) do
						if v == tramp then
							foundTramp = true
						elseif typeof(v) == "Instance" and v:IsA("RemoteEvent") and v:IsDescendantOf(netFolder) then
							foundRemote = v
						end
					end
					if foundTramp and foundRemote then
						print("[GetXP] Found remote via getgc trampoline model:", foundRemote.Name)
						return foundRemote
					end
				end
			end
		end
	end

	-- Method 3: Use getconnections on OnClientEvent + check source for trampoline references
	if _getconnections then
		for _, remote in ipairs(allRemotes) do
			local ok, conns = pcall(_getconnections, remote.OnClientEvent)
			if ok and type(conns) == "table" then
				for _, c in ipairs(conns) do
					local fOk, fn = pcall(function() return c.Function end)
					if fOk and type(fn) == "function" then
						local src = getFuncSource(fn):lower()
						if src:find("trampoline") then
							print("[GetXP] Found remote via OnClientEvent source:", remote.Name, "src:", src)
							return remote
						end
					end
				end
			end
		end
	end

	-- Method 4: Search getgc for functions whose source mentions trampoline, extract RemoteEvent from upvalues
	if _getgc and _getinfo and _getupvalues then
		local gc = _getgc()
		local checked = 0
		for _, func in ipairs(gc) do
			if type(func) == "function" then
				checked = checked + 1
				if checked > 50000 then break end
				local src = getFuncSource(func):lower()
				if src:find("trampoline") then
					local ok, ups = pcall(_getupvalues, func)
					if ok and type(ups) == "table" then
						for _, v in pairs(ups) do
							if typeof(v) == "Instance" and v:IsA("RemoteEvent") and v:IsDescendantOf(netFolder) then
								print("[GetXP] Found remote via source + upvalues:", v.Name)
								return v
							end
						end
					end
				end
			end
		end
	end

	-- Method 5: Try Net library API if available
	local netModule = netFolder:FindFirstChild("Net")
	if netModule and netModule:IsA("ModuleScript") then
		local ok, netLib = pcall(require, netModule)
		if ok and netLib and type(netLib) == "table" then
			for _, methodName in ipairs({"GetRemote", "getRemote", "WaitForRemote", "Resolve", "resolve"}) do
				if type(netLib[methodName]) == "function" then
					for _, candidateName in ipairs({"Bounce", "BounceTrampoline", "TrampolineBounce", "Trampoline", "Jump", "JumpTrampoline"}) do
						local rOk, result = pcall(netLib[methodName], netLib, candidateName)
						if rOk and result and typeof(result) == "Instance" and result:IsA("RemoteEvent") then
							print("[GetXP] Found remote via Net library API:", result.Name)
							return result
						end
					end
				end
			end
		end
	end

	warn("[GetXP] Could not find remote for trampoline:", trampName)
	return nil
end

-- Get XP Main Loop
task.spawn(function()
	while true do
		if getXpEnabled then
			local trampName = getPlayerTrampolineName()

			if trampName then
				-- Re-discover remote if trampoline changed or cache is invalid
				local needSearch = false
				if trampName ~= cachedTrampolineName then
					needSearch = true
				elseif not cachedRemote or not cachedRemote.Parent then
					needSearch = true
				end

				if needSearch then
					cachedTrampolineName = trampName
					cachedRemote = findTrampolineRemote(trampName)
					if cachedRemote then
						print("[GetXP] Using remote for", trampName, "->", cachedRemote.Name)
					else
						warn("[GetXP] No remote found for", trampName, "- retrying next cycle")
						task.wait(2)
						continue
					end
				end

				if cachedRemote and cachedRemote.Parent then
					-- Get the Weld part for the trampoline
					local mapFolder = workspace:FindFirstChild("Map")
					local baseTrampolines = mapFolder and mapFolder:FindFirstChild("BaseTrampolines")
					local tramp = baseTrampolines and baseTrampolines:FindFirstChild(trampName)
					local weld = tramp and tramp:FindFirstChild("Weld")

					if weld then
						-- Fire the remote 65 times with 0.1s cooldown
						for i = 1, 65 do
							if not getXpEnabled then break end
							pcall(function()
								cachedRemote:FireServer(weld)
							end)
							task.wait(0.1)
						end

						-- Wait 5 seconds before repeating
						if getXpEnabled then
							task.wait(5)
						end
					else
						warn("[GetXP] Weld not found for trampoline:", trampName)
						cachedRemote = nil
						task.wait(1)
					end
				else
					-- Remote became invalid, clear cache and retry
					cachedRemote = nil
					task.wait(1)
				end
			else
				-- No trampoline found, wait and retry
				task.wait(1)
			end
		else
			-- Get XP is OFF, clear cache and wait
			cachedTrampolineName = nil
			cachedRemote = nil
			task.wait(1)
		end
	end
end)

