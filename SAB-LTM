-- 2. Draggable UI System
local function enableDragging(frame, titleBar)
	local dragging = false
	local dragInput, dragStart, startPos

	local function update(input)
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(
			startPos.X.Scale, 
			startPos.X.Offset + delta.X, 
			startPos.Y.Scale, 
			startPos.Y.Offset + delta.Y
		)
	end

	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	titleBar.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			update(input)
		end
	end)
end

-- 3. Base Location & Trampoline Detection System
local function getPlayerBasePart()
	local plotsFolder = workspace:FindFirstChild("Plots")
	if not plotsFolder then return nil end

	for _, plot in ipairs(plotsFolder:GetChildren()) do
		if plot:GetAttribute("OwnerUserId") == userId then
			local expansionFolder = plot:FindFirstChild("Expansion")
			if expansionFolder then
				for _, child in ipairs(expansionFolder:GetChildren()) do
					if child.Name == "Post" and child:IsA("BasePart") then
						return child
					end
				end
			end
		end
	end
	return nil
end

local function getPlayerTrampolineName()
	local plotsFolder = workspace:FindFirstChild("Plots")
	if not plotsFolder then return nil end

	local playerOrder = nil
	for _, plot in ipairs(plotsFolder:GetChildren()) do
		if plot:GetAttribute("OwnerUserId") == userId then
			playerOrder = plot:GetAttribute("Order")
			break
		end
	end

	if not playerOrder then return nil end

	local mapFolder = workspace:FindFirstChild("Map")
	if not mapFolder then return nil end
	local baseTrampolines = mapFolder:FindFirstChild("BaseTrampolines")
	if not baseTrampolines then return nil end

	for _, tramp in ipairs(baseTrampolines:GetChildren()) do
		if tramp:GetAttribute("BasePlotOrder") == playerOrder then
			print("Detected Player Trampoline:", tramp.Name)
			return tramp.Name
		end
	end

	return nil
end

-- 4. Closest Part Calculation
local function getClosestPartIndexToPosition(pos)
	local closestIndex = 1
	local shortestDistance = math.huge

	for index, part in ipairs(createdParts) do
		local distance = (pos - part.Position).Magnitude
		if distance < shortestDistance then
			shortestDistance = distance
			closestIndex = index
		end
	end

	return closestIndex
end

local function getClosestPartIndex()
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return 1 end
	local idx = getClosestPartIndexToPosition(character.HumanoidRootPart.Position)
	if createdParts[idx] then
		print("Closest Teleport Part:", createdParts[idx].Name)
	end
	return idx
end

-- 5. Sequential Teleport System
local isTeleporting = false

local function teleportSequenceTo(targetIndex)
	if isTeleporting then return end
	isTeleporting = true

	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then 
		isTeleporting = false
		return 
	end

	local hrp = character.HumanoidRootPart
	local startIndex = getClosestPartIndex()

	if startIndex <= targetIndex then
		for i = startIndex, targetIndex do
			local targetPart = createdParts[i]
			if targetPart then
				hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
				task.wait(0.3)
			end
		end
	else
		for i = startIndex, targetIndex, -1 do
			local targetPart = createdParts[i]
			if targetPart then
				hrp.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
				task.wait(0.3)
			end
		end
	end

	isTeleporting = false
end

-- Teleport to Player Base
local function teleportToBase()
	local basePart = getPlayerBasePart()
	if not basePart then
		warn("[ERROR]: Base not found in Workspace.Plots!")
		return
	end

	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local hrp = character.HumanoidRootPart

	teleportSequenceTo(1)
	task.wait(0.3)
	hrp.CFrame = basePart.CFrame + Vector3.new(0, 3, 0)
end

-- Teleport to Egg (75 Studs Offset)
local function teleportToEgg(eggObject)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local hrp = character.HumanoidRootPart

	local eggPosition
	if eggObject:IsA("BasePart") then
		eggPosition = eggObject.Position
	elseif eggObject:IsA("Model") then
		eggPosition = eggObject:GetPivot().Position
	else
		return
	end

	local closestIndexToEgg = getClosestPartIndexToPosition(eggPosition)
	teleportSequenceTo(closestIndexToEgg)

	task.wait(0.2)
	local currentPart = createdParts[closestIndexToEgg]
	if currentPart then
		hrp.CFrame = currentPart.CFrame + Vector3.new(0, 75, 0)
		task.wait(0.3)
	end

	hrp.CFrame = CFrame.new(eggPosition + Vector3.new(0, 3, 0))
end

-- Check Object Visibility
local function isObjectVisible(obj)
	if obj:IsA("BasePart") then
		return obj.Transparency < 1
	elseif obj:IsA("Model") then
		for _, desc in ipairs(obj:GetDescendants()) do
			if desc:IsA("BasePart") and desc.Transparency < 1 then
				return true
			end
		end
	end
	return false
end

-- Check if Name ends strictly with 'Egg'
local function nameEndsWithEgg(name)
	local trimmedName = string.match(name, "^%s*(.-)%s*$")
	return string.sub(trimmedName, -3) == "Egg"
end

-- Helper function to safely locate AnimalOverhead UI container inside egg models
local function getAnimalOverhead(eggObj)
	local fakeRoot = eggObj:FindFirstChild("FakeRootPart")
	if not fakeRoot then return nil end
	local hatAttach = fakeRoot:FindFirstChild("HatAttachment")
	if not hatAttach then return nil end
	local overheadAttach = hatAttach:FindFirstChild("OVERHEAD_ATTACHMENT")
	if not overheadAttach then return nil end
	return overheadAttach:FindFirstChild("AnimalOverhead")
end

-- Apply Fast Grab setting to an egg model
local function applyFastGrab(eggObj)
	if not fastGrabEnabled then return end
	local rootPart = eggObj:FindFirstChild("RootPart")
	if rootPart then
		for _, desc in ipairs(rootPart:GetDescendants()) do
			if desc:IsA("ProximityPrompt") then
				desc.HoldDuration = 0
			end
		end
	end
end

-- Apply Price visibility to an egg model
local function applyPriceVisibility(eggObj)
	local animalOverhead = getAnimalOverhead(eggObj)
	if animalOverhead then
		local priceLabel = animalOverhead:FindFirstChild("Price")
		if priceLabel and priceLabel:IsA("TextLabel") then
			priceLabel.Visible = showEggPriceEnabled
		end
	end
end

