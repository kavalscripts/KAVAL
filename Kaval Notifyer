local function fn2(arg)
	local n = tonumber(arg) or 0
	if n >= 1000000 then
		return string.format("%.1fM", n / 1000000):gsub("%.0M", "M")
	end

	if n >= 1000 then
		return string.format("%.1fK", n / 1000):gsub("%.0K", "K")
	end
	return tostring(n)
end

