                    p.HoldDuration = 1.5
                    if carrying then
                        p.Enabled = true
                        p.ActionText = "Place"
                        p.ObjectText = (fakeGrab.entry and fakeGrab.entry.Index) or ""
                        p:SetAttribute("State", "Place")
                    else
                        local placedEntry = placedClones[slot] and placedClones[slot].animalEntry
                        local entry = placedEntry or info.animalEntry
                        if entry then
