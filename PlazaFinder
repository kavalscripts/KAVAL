local function recordWindowPosition()
	local pos = mainWindow.Position
	savedWindowPos = { pos.X.Scale, pos.X.Offset, pos.Y.Scale, pos.Y.Offset }
	saveConfig()
end

local function clampWindowToScreen(shouldSave)
	local screenSize = screenGui.AbsoluteSize
	local windowSize = mainWindow.AbsoluteSize

	if screenSize.X <= 0 or screenSize.Y <= 0 or windowSize.X <= 0 then
		return
	end

	local pos = mainWindow.Position
	local currentX = pos.X.Scale * screenSize.X + pos.X.Offset
	local currentY = pos.Y.Scale * screenSize.Y + pos.Y.Offset
	local clampedX = math.clamp(currentX, 0, math.max(screenSize.X - windowSize.X, 0))
	local clampedY = math.clamp(currentY, 0, math.max(screenSize.Y - windowSize.Y, 0))

	if clampedX ~= currentX or clampedY ~= currentY then
		mainWindow.Position = UDim2.new(0, clampedX, 0, clampedY)

		if shouldSave then
			recordWindowPosition()
		end
	end
end

