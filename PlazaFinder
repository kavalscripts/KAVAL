end

local function tweenObject(instance, goals, duration, easingStyle, easingDirection)
	if not instance or not instance.Parent then
		return
	end

	TweenService:Create(
		instance,
		TweenInfo.new(duration or 0.18, easingStyle or Enum.EasingStyle.Quint, easingDirection or Enum.EasingDirection.Out),
		goals
	):Play()
end

local function playShimmer(target)
	if not target or not target.Parent then
		return
	end

	local shimmer = createInstance("Frame", {
		BackgroundColor3 = Color3.fromRGB(190, 190, 205),
		BackgroundTransparency = 0.86,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 30, 1, 0),
		Position = UDim2.new(0, -36, 0, 0),
		ZIndex = target.ZIndex + 2,
	}, target)

	createInstance("UIGradient", {
		Rotation = 20,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0.25),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, shimmer)

	tweenObject(shimmer, {
		Position = UDim2.new(1, 20, 0, 0),
		BackgroundTransparency = 0.96,
	}, 0.34, Enum.EasingStyle.Quad)

	task.delay(0.38, function()
		if shimmer then
			shimmer:Destroy()
		end
	end)
end

local function attachButtonFeel(button)
	local uiScale = createInstance("UIScale", { Scale = 1 }, button)

	button.MouseButton1Down:Connect(function()
		tweenObject(uiScale, { Scale = 0.96 }, 0.08, Enum.EasingStyle.Quad)
	end)

	button.MouseButton1Up:Connect(function()
		tweenObject(uiScale, { Scale = 1 }, 0.16, Enum.EasingStyle.Back)
	end)

	button.MouseLeave:Connect(function()
		tweenObject(uiScale, { Scale = 1 }, 0.16, Enum.EasingStyle.Back)
	end)

	button.MouseButton1Click:Connect(function()
		playShimmer(button)
	end)

	return uiScale
end

local function formatCurrency(amount)
	local num = tonumber(amount) or 0

	if num >= 1e15 then
		return string.format("$%.1fQa", num / 1e15)
	end

	if num >= 1e12 then
		return string.format("$%.1fT", num / 1e12)
	end

	if num >= 1e9 then
		return string.format("$%.1fB", num / 1e9)
	end

	if num >= 1000000 then
		return string.format("$%.1fM", num / 1000000)
	end

	if num >= 1000 then
		return string.format("$%.1fK", num / 1000)
	end

	return "$" .. math.floor(num)
end

