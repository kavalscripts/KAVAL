local tradeRemoteFunction = nil
local tradeRemoteUuid = nil
do
	local getupvalues_ = debug and debug.getupvalues or getupvalues
	local getconstants_ = debug and debug.getconstants or getconstants

	local function findNetRemoteUpvalue(fn, className)
		if type(fn) ~= "function" or type(getupvalues_) ~= "function" then
			return nil
		end

		local ok, upvalues = pcall(getupvalues_, fn)

		if not ok or type(upvalues) ~= "table" then
			return nil
		end

		local matchingIndices = {}

		for index, value in pairs(upvalues) do
			local isMatch = type(index) == "number"

			if isMatch then
				isMatch = typeof(value) == "Instance"
			end

			if isMatch and value:IsA(className) and net and value:IsDescendantOf(net) then
				table.insert(matchingIndices, index)
			end
		end

		if #matchingIndices == 0 then
			return nil
		end

		table.sort(matchingIndices)

		return upvalues[matchingIndices[1]]
	end

	if tradeController and type(tradeController.SendInvite) == "function" then
		tradeRemoteFunction = findNetRemoteUpvalue(tradeController.SendInvite, "RemoteFunction")

		if type(getconstants_) == "function" then
			local ok, constants = pcall(getconstants_, tradeController.SendInvite)

			if ok then
				ok = type(constants) == "table"
			end

			if ok then
				for _, constant in pairs(constants) do
					if type(constant) == "string" and constant:match("^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") then
						tradeRemoteUuid = constant
						break
					end
				end
			end
		end
	end
end

--=====================================================================
-- Invite sending
--=====================================================================

do
	local function formatInviteError(rawMessage, defaultCooldown)
		local message = type(rawMessage) == "string" and rawMessage ~= "" and rawMessage or "Rejected"
		local lowered = message:lower()
		local extractedSeconds = lowered:find("cooldown", 1, true) and tonumber(message:match("[%d%.]+")) or nil

		if not (lowered:find("pending trade", 1, true) or lowered:find("pending duel", 1, true) or lowered:find("pending invite", 1, true)) then
			defaultCooldown = extractedSeconds
		end

		if defaultCooldown then
			return string.format("Cooldown %ds", math.ceil(defaultCooldown))
		end

		return message
	end

	function GameBridge.SendInvite(kind, targetUserId, callback)
		local done = callback or function() end

		if kind ~= "duel" and kind ~= "trade" then
			return done(false, "bad invite kind: " .. tostring(kind))
		end

		local userId = tonumber(targetUserId)

		if not userId or userId <= 0 then
			return done(false, "no userId on that listing")
		end

		if userId ~= localPlayer.UserId then
			if kind == "duel" then
				if not duelsController or type(duelsController.SendInvite) ~= "function" then
					return done(false, "duels unavailable")
				end

				if type(duelsController.IsEnabled) == "function" then
					local ok, enabled = pcall(function()
						return duelsController:IsEnabled()
					end)

					if ok and not enabled then
						return done(false, "duels disabled right now")
					end
				end

				task.spawn(function()
					local ok, success, reason = pcall(function()
						return duelsController:SendInvite(userId)
					end)

					if not ok then
						done(false, "invite errored")
					elseif success == false then
						done(false, formatInviteError(reason, CONFIG.duelCooldown))
					else
						done(true, "DUEL INVITE SENT")
					end
				end)

				return
			end

			task.spawn(function()
				if tradeController and type(tradeController.SendInvite) == "function" then
					local resolved = false

					local ok, success, reason = pcall(function()
						return tradeController:SendInvite(userId, function(accepted, callbackReason)
							if resolved then
								return
							end

							resolved = true

							if accepted == true then
								done(true, "TRADE INVITE SENT")
							else
								done(false, formatInviteError(callbackReason, CONFIG.tradeCooldown))
							end
						end)
					end)

					if not ok then
						if not resolved then
							resolved = true
							done(false, "invite errored")
						end

						return
					end

					if success == false and not resolved then
						resolved = true
						done(false, formatInviteError(reason, CONFIG.tradeCooldown))

						return
					end

					task.delay(15, function()
						if not resolved then
							resolved = true
							done(false, "invite timed out")
						end
					end)

					return
				end

				if not tradeRemoteFunction then
					return done(false, "no trade remote")
				end

				local ok, success, reason = pcall(function()
					return tradeRemoteFunction:InvokeServer(tradeRemoteUuid, userId)
				end)

				if not ok then
					done(false, "invite errored")
				elseif success == false then
					done(false, formatInviteError(reason, CONFIG.tradeCooldown))
				else
					done(true, "TRADE INVITE SENT")
				end
			end)

			return
		end

		return done(false, "that's your own listing")
	end
end

