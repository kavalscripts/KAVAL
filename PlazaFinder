}

local spinningViewports = {}

RunService.RenderStepped:Connect(function(deltaTime)
	for i = #spinningViewports, 1, -1 do
		local entry = spinningViewports[i]

		if not entry.Viewport.Parent or not entry.Camera.Parent then
			table.remove(spinningViewports, i)
		else
			entry.Angle = entry.Angle + deltaTime * entry.Speed
			local offsetX = math.sin(entry.Angle) * entry.Radius
			local offsetZ = math.cos(entry.Angle) * entry.Radius
			local offsetY = math.sin(entry.Angle * 2) * entry.Float

			entry.Camera.CFrame = CFrame.new(
				Vector3.new(entry.Center.X + offsetX, entry.Center.Y + offsetY, entry.Center.Z + offsetZ),
				entry.Center
			)
		end
	end
end)

local previewTaskQueue = {}
local isProcessingPreviewQueue = false

local function enqueuePreviewTask(taskFn)
	table.insert(previewTaskQueue, taskFn)

	if isProcessingPreviewQueue then
		return
	end

	isProcessingPreviewQueue = true

	task.spawn(function()
		while #previewTaskQueue > 0 do
			local nextTask = table.remove(previewTaskQueue, 1)

			if nextTask then
				task.spawn(nextTask)
			end

			RunService.Heartbeat:Wait()
		end

		isProcessingPreviewQueue = false
	end)
end

local function createBrainrotPreview(parent, itemName, width, height, cornerRadius, mutationName)
	height = height or width

	local previewFrame = createInstance("Frame", {
		Name = "Preview",
		Size = UDim2.new(0, width, 0, height),
		BackgroundColor3 = Color3.fromRGB(8, 8, 9),
		BorderSizePixel = 0,
		ClipsDescendants = true,
		ZIndex = 6,
	}, parent)

	addCorner(previewFrame, cornerRadius or 8)
	addStroke(previewFrame, COLOR_WHITE, 1, 0.84)

	local cleanName = (itemName or "?"):gsub("[^%w ]", "")
	local firstChar, secondChar = cleanName:match("^(%S)%S*%s+(%S)")
	local initials = string.upper(firstChar and (firstChar .. secondChar) or cleanName:sub(1, 2))

	local fallbackLabel = createInstance("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = initials,
		TextColor3 = getActiveTheme().accent,
		Font = Enum.Font.GothamBlack,
		TextSize = math.floor(math.min(width, height) * 0.34),
		ZIndex = 7,
	}, previewFrame)

	fallbackLabel.TextTransparency = 0.25

	local viewport = createInstance("ViewportFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(190, 190, 190),
		LightColor = Color3.fromRGB(255, 255, 255),
		LightDirection = Vector3.new(-1, -1.2, -0.8),
		ZIndex = 8,
		Visible = false,
	}, previewFrame)

	enqueuePreviewTask(function()
		if not previewFrame.Parent then
			return
		end

		local sourceModel = GameBridge.BrainrotModel(itemName)

		if not sourceModel or not previewFrame.Parent then
			return
		end

		local ok, clone = pcall(function()
			sourceModel.Archivable = true
			return sourceModel:Clone()
		end)

		if not ok or not clone then
			return
		end

		for _, descendant in ipairs(clone:GetDescendants()) do
			for _, className in ipairs(STRIPPED_PREVIEW_CLASSES) do
				if descendant:IsA(className) then
					descendant:Destroy()
					break
				end
			end
		end

		local mutation = mutationName

		if mutation and mutation ~= "" and mutation ~= "None" and mutation ~= "Default" and animalsShared and type(animalsShared.ApplyMutation) == "function" then
			local appliedOk, cleanup = pcall(function()
				return animalsShared:ApplyMutation(clone, itemName, mutation)
			end)

			if appliedOk and cleanup then
				previewFrame.Destroying:Connect(function()
					if typeof(cleanup) == "RBXScriptConnection" then
						cleanup:Disconnect()
					elseif typeof(cleanup) == "Instance" then
						cleanup:Destroy()
					elseif type(cleanup) == "function" then
						pcall(cleanup)
					end
				end)
			end
		end

		local primaryPart = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)

		if not primaryPart then
			clone:Destroy()
			return
		end

		clone.PrimaryPart = primaryPart

		pcall(function()
			clone:PivotTo(CFrame.new(0, 0, 0))
		end)

		clone.Parent = createInstance("WorldModel", {}, viewport)

		local camera = createInstance("Camera", { FieldOfView = 50 }, viewport)
		viewport.CurrentCamera = camera

		local boundingCFrame, boundingSize = clone:GetBoundingBox()
		local idleAnimation = GameBridge.BrainrotAnimation(itemName)
		local hasIdleAnimation = idleAnimation ~= nil
		local aspect = height > 0 and (width / height) or 1
		local horizontalExtent = (hasIdleAnimation and boundingSize.X or math.sqrt(boundingSize.X * boundingSize.X + boundingSize.Z * boundingSize.Z)) * 0.5 / 0.46630765815499858 * aspect
		local cameraDistance = math.max(boundingSize.Y * 0.5 / 0.46630765815499858, horizontalExtent, 0.6) * 1.15
		local centerPos = boundingCFrame.Position
		local isAnimated = false

		if idleAnimation then
			isAnimated = pcall(function()
				local existingController = clone:FindFirstChild("AnimationController")

				if existingController then
					existingController:Destroy()
				end

				local humanoid = createInstance("Humanoid", {
					Name = "AnimationController",
					EvaluateStateMachine = false,
					PlatformStand = true,
					DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None,
				}, clone)

				local animTrack = createInstance("Animator", {}, humanoid):LoadAnimation(idleAnimation)
				animTrack.Looped = true
				animTrack.Priority = Enum.AnimationPriority.Idle
				animTrack:Play()

				previewFrame.Destroying:Connect(function()
					pcall(function()
						animTrack:Stop()
					end)
				end)

				task.spawn(function()
					for _ = 1, 50 do
						if not previewFrame.Parent then
							return
						end

						if animTrack.Length > 0 then
							pcall(function()
								animTrack.TimePosition = math.random() * animTrack.Length
							end)

							return
						end

						task.wait(0.05)
					end
				end)
			end)
		end

		local initialAngle = isAnimated and math.pi or 3.4557519189487724

		camera.CFrame = CFrame.new(
			Vector3.new(centerPos.X + math.sin(initialAngle) * cameraDistance, centerPos.Y, centerPos.Z + math.cos(initialAngle) * cameraDistance),
			centerPos
		)

		if not isAnimated then
			table.insert(spinningViewports, {
				Viewport = viewport,
				Camera = camera,
				Center = centerPos,
				Radius = cameraDistance,
				Angle = initialAngle,
				Speed = 0.62,
				Float = math.max(boundingSize.Y * 0.02, 0.015),
			})
		end

		if previewFrame.Parent then
			viewport.Visible = true
			fallbackLabel.Visible = false
		end
	end)

	return previewFrame
end

