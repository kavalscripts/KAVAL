				minimized = isMinimized,
				tab = selectedTab,
			}

			if not pcall(function()
				writefile("KavalHubPlazaFinder.json", HttpService:JSONEncode(configData))
			end) then
				_G.AceDuelsFinderConfig = configData
			end
		end)
	end

	local data = nil

	if not pcall(function()
		if isfile and isfile("KavalHubPlazaFinder.json") then
			data = HttpService:JSONDecode(readfile("KavalHubPlazaFinder.json"))
		end
	end) or not data then
		data = _G.AceDuelsFinderConfig
	end

	if type(data) == "table" then
		if type(data.theme) == "number" and THEMES[data.theme] then
			currentThemeIndex = data.theme
		end

		if data.minimized ~= nil then
			isMinimized = data.minimized
		end

		if data.tab == "DUELS" or data.tab == "TRADES" then
			selectedTab = data.tab
		end

		if isValidPositionArray(data.pos) then
			savedWindowPos = data.pos
		end
	end
end

local function getActiveTheme()
	return THEMES[currentThemeIndex] or THEMES[1]
end

