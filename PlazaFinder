local function filterListingCards(scrollFrame, emptyLabel, defaultEmptyMessage)
	local query = string.lower(searchBox.Text or "")
	local anyVisible = false

	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("Frame") and child.Name:match("^Card_") then
			local searchText = child:GetAttribute("Search") or ""
			local visible = query == "" or searchText:find(query, 1, true) ~= nil

			child.Visible = visible
			anyVisible = anyVisible or visible
		end
	end

	emptyLabel.Visible = not anyVisible
	emptyLabel.Text = query ~= "" and "NO MATCHES\nnothing matches that search" or defaultEmptyMessage
end

