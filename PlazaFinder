local STRIPPED_PREVIEW_CLASSES = {
	"Script",
	"LocalScript",
	"Sound",
	"ParticleEmitter",
	"BillboardGui",
	"SurfaceGui",
	"Beam",
	"Trail",
	"Fire",
	"Smoke",
