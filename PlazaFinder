local copyToClipboard
do
	local clipboardFn = setclipboard or toclipboard or set_clipboard
	local writeClipboard

	if clipboardFn then
		writeClipboard = clipboardFn
	else
		writeClipboard = syn and syn.write_clipboard
	end

	copyToClipboard = function(text)
		if type(writeClipboard) ~= "function" or type(text) ~= "string" or text == "" then
			return false
		end

		return (pcall(writeClipboard, text))
	end
end

local renderListings
do
	local function onInviteButtonClicked(kind, listing, card, button)
		local originalText = button.Text
		button.Text = "..."

		GameBridge.SendInvite(kind, listing.userId, function(ok, reason)
			if not button.Parent then
				return
			end

			if ok then
				local copied = copyToClipboard(listing.username)
				reason = reason or "INVITE SENT"

				showToast(reason .. "  Â·  " .. listing.username .. (copied and "  Â·  NAME COPIED" or ""), getActiveTheme().accent)

				button.Text = "SENT"
				playShimmer(button)

				task.delay(2.5, function()
					if button.Parent then
						button.Text = originalText
					end
				end)
			else
				showToast(string.upper(reason or "FAILED"), COLOR_WARNING)
				button.Text = originalText
			end
		end)
	end

	local listingCards = { duel = {}, trade = {} }

	renderListings = function(kind)
		local parent = kind == "duel" and duelsScrollingFrame or tradesScrollingFrame
		local emptyLabel = kind == "duel" and duelsEmptyLabel or tradesEmptyLabel
		local cards = listingCards[kind]
		local listings = listingsByKind[kind]

		table.sort(listings, function(a, b)
			return (a.postedAt or 0) > (b.postedAt or 0)
		end)

		local liveIds = {}
		local count = 0

		local function isMine(listing)
			if listing.userId and localPlayer.UserId and listing.userId == localPlayer.UserId then
				return true
			end

			return clientId ~= nil and listing.clientId == clientId
		end

		local function upsert(listing, mine)
			count += 1
			liveIds[listing.listingId] = true

			local card = cards[listing.listingId]

			if not card or not card.Parent or card:GetAttribute("Mine") ~= mine then
				if card and card.Parent then
					card:Destroy()
				end

				card = createListingCard(parent, listing, kind, onInviteButtonClicked, mine)
				card:SetAttribute("Mine", mine)
				cards[listing.listingId] = card
			end

			card.LayoutOrder = mine and -1000 + count or count
		end

		for _, listing in ipairs(listings) do
			if isMine(listing) then
				upsert(listing, true)
			end
		end

		for _, listing in ipairs(listings) do
			if not isMine(listing) then
				upsert(listing, false)
			end
		end

		for listingId, card in pairs(cards) do
			if not liveIds[listingId] then
				if card.Parent then
					card:Destroy()
				end

				cards[listingId] = nil
			end
		end

		local badge = tabButtons[kind == "duel" and "DUELS" or "TRADES"].badge
		badge.Visible = count > 0
		badge.Text = tostring(math.min(count, 99))

		filterListingCards(parent, emptyLabel, EMPTY_MESSAGES[kind])
	end

	searchBox:GetPropertyChangedSignal("Text"):Connect(applySearchFilter)
end

