local avatarThumbnailCache = {}

local CardHelpers = {
	WIDTH = 320,
	textWidth = function(text, textSize, font)
		local ok, width = pcall(function()
			return game:GetService("TextService"):GetTextSize(text, textSize, font, Vector2.new(1000, 40)).X
		end)

		return ok and width and math.ceil(width) or nil
	end,
	traits = function(listing)
		return type(listing.traitList) == "string" and listing.traitList or ""
	end,
	where = function(listing)
		local parts = {}

		if type(listing.region) == "string" and listing.region ~= "" then
			table.insert(parts, listing.region)
		end

		local ping = tonumber(listing.pingMs)

		if ping and ping > 0 then
			table.insert(parts, string.format("~%dms", math.floor(ping + 0.5)))
		end

		return table.concat(parts, "  Â·  ")
	end,
	avatar = function(userId, imageLabel)
		local id = tonumber(userId)

		if not id or id <= 0 then
			return
		end

		if avatarThumbnailCache[id] then
			imageLabel.Image = avatarThumbnailCache[id]
			return
		end

		task.spawn(function()
			local ok, thumbnailUrl = pcall(function()
				return Players:GetUserThumbnailAsync(id, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			end)

			if ok and type(thumbnailUrl) == "string" and thumbnailUrl ~= "" then
