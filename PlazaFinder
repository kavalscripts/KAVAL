function CardHelpers.metaStrip(parent, mutationName, traitString, zIndex)
	local stripFrame = createInstance("Frame", {
		Name = "Meta",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = zIndex,
	}, parent)

	createInstance("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 5),
	}, stripFrame)

	local order = 0

	local function addPill(label, color)
		order += 1

		local pill = createInstance("TextLabel", {
			LayoutOrder = order,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 0, 14),
			BackgroundColor3 = COLOR_BLACK,
			BackgroundTransparency = 0.25,
			Text = string.upper(label),
			TextColor3 = color,
			Font = Enum.Font.GothamBold,
			TextSize = 8,
			ZIndex = zIndex + 1,
		}, stripFrame)

		addCorner(pill, 4)
		addStroke(pill, color, 1, 0.55)
		createInstance("UIPadding", {
			PaddingLeft = UDim.new(0, 5),
			PaddingRight = UDim.new(0, 5),
		}, pill)

		return pill
	end

	local validMutation = mutationName and mutationName ~= "" and mutationName ~= "None" and mutationName or nil

	addPill(
		validMutation or "NORMAL",
		validMutation and (GameBridge.MutationColor(validMutation) or getActiveTheme().accent) or COLOR_TEXT_SECONDARY
	)

	local traits = GameBridge.SplitTraits(traitString)
	local visibleCount = math.min(#traits, 4)

	for i = 1, visibleCount do
		local traitName = traits[i]
		local iconAsset, traitColor = GameBridge.TraitInfo(traitName)

		if iconAsset then
			order += 1

			createInstance("ImageLabel", {
				Name = "Trait_" .. traitName,
				LayoutOrder = order,
				Size = UDim2.new(0, 14, 0, 14),
				BackgroundTransparency = 1,
				Image = iconAsset,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = zIndex + 1,
			}, stripFrame)
		else
			addPill(traitName, traitColor or COLOR_TEXT_MUTED)
		end
	end

	if visibleCount < #traits then
		addPill("+" .. (#traits - visibleCount), COLOR_TEXT_MUTED)
	end

	return stripFrame
end

