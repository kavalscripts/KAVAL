do
	local isDragging = false
	local dragStartInput = nil
	local dragStartPos = nil
	local lastInput = nil

	local function isOverHideButton(position)
		if hideButton.Visible then
			local absolutePosition = hideButton.AbsolutePosition
			local absoluteSize = hideButton.AbsoluteSize

			return position.X >= absolutePosition.X
				and position.X <= absolutePosition.X + absoluteSize.X
				and position.Y >= absolutePosition.Y
				and position.Y <= absolutePosition.Y + absoluteSize.Y
		end

		return false
	end

	headerFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if isOverHideButton(input.Position) then
				return
			end

			local position = input.Position
			local windowPos = mainWindow.Position

			isDragging = true
			dragStartInput = position
			dragStartPos = windowPos
		end
	end)

	headerFrame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			lastInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		local shouldDrag = isDragging

		if isDragging then
			shouldDrag = input == lastInput
				or input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
		end

		if shouldDrag and mainWindow.Parent then
			local delta = input.Position - dragStartInput
			mainWindow.Position = UDim2.new(
				dragStartPos.X.Scale,
				dragStartPos.X.Offset + delta.X,
				dragStartPos.Y.Scale,
				dragStartPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if isDragging then
				isDragging = false
				clampWindowToScreen(false)
				recordWindowPosition()
			end
		end
	end)
end

--=====================================================================
-- WebSocket client
--=====================================================================

do
	local websocket = nil
	local isConnected = false
	local lastPingTime = 0
	local backoff = CONFIG.backoffMin
	local isConnecting = false
	local connections = {}

	local function setStatus(text, textColor, backgroundColor)
		statusTextLabel.Text = text
		statusTextLabel.TextColor3 = textColor
		statusDotFrame.BackgroundColor3 = backgroundColor or textColor
		statusCountLabel.Visible = false
	end

	local function sendMessage(payload)
		if not websocket then
			return false
		end

		local ok = pcall(function()
			websocket:Send(HttpService:JSONEncode(payload))
		end)

		if not ok then
			isConnected = false
		end

		return ok
	end

	SocketClient.send = function(payload)
		if not websocket or not isConnected then
			showToast("NOT CONNECTED", COLOR_DANGER)
			return false
		end

		return sendMessage(payload)
	end

	local function handleMessage(message)
		local messageType = message.type

		if messageType == "connect_ok" then
			clientId = message.clientId
		elseif messageType == "identify_ok" then
			clientId = message.clientId or clientId
			isConnected = true
			isIdentified = true
			backoff = CONFIG.backoffMin
			setStatus("ONLINE", COLOR_TEXT_PRIMARY, COLOR_SUCCESS)
			updateStatusCount()
			lastPingTime = os.clock()
			sendMessage({ type = "ping", ts = lastPingTime })
		elseif messageType == "pong" then
			local elapsed = (os.clock() - lastPingTime) * 1000

			if elapsed > 0 and elapsed < 10000 then
				currentPingMs = math.floor(elapsed + 0.5)
			end
		elseif messageType == "presence" then
			onlinePlayerCount = tonumber(message.count) or 0
			updateStatusCount()
		elseif messageType == "listings" then
			if type(message.data) ~= "table" then
				return
			end

			listingsByKind.duel = {}
			listingsByKind.trade = {}

			local data = message.data or {}

			for _, listing in ipairs(data) do
				if GameBridge.IsRealBrainrot(listing.item) then
					if listing.kind == "trade" then
						table.insert(listingsByKind.trade, listing)
					else
						table.insert(listingsByKind.duel, listing)
					end

					if (listing.userId and listing.userId == localPlayer.UserId) or listing.clientId == clientId then
						ownActiveListings[listing.listingId] = listing
					end
				end
			end

			for listingId in pairs(ownActiveListings) do
				local stillPresent = false

				for _, listing in ipairs(data) do
					if listing.listingId == listingId then
						stillPresent = true
						break
					end
				end

				if not stillPresent then
					ownActiveListings[listingId] = nil
				end
			end

			renderListings("duel")
			renderListings("trade")

			for _, section in pairs(postSections) do
				section.refreshActive()
			end
		elseif messageType == "post_ok" then
			showToast("LISTING POSTED", getActiveTheme().accent)
		elseif messageType == "post_rejected" then
			if message.reason == "cooldown" then
				showToast(
					string.format(
						"%sCOOLDOWN %ds",
						message.kind and string.upper(message.kind) .. " " or "",
						math.ceil((message.retryInMs or 0) / 1000)
					),
					COLOR_WARNING
				)
			else
				showToast("REJECTED: " .. string.upper(tostring(message.reason)), COLOR_DANGER)
			end
		elseif messageType == "error" then
			showToast(string.upper(tostring(message.message)), COLOR_DANGER)
		end
	end

	local scheduleReconnect

	local function attemptConnect()
		if isConnecting or isConnected then
			return
		end

		if not isCurrentRun() or not screenGui.Parent then
			return
		end

		if not connect then
			setStatus("NO WEBSOCKET", COLOR_DANGER)
			return
		end

		if CONFIG.wsUrl:find("CHANGE%-ME") then
			setStatus("UNCONFIGURED", COLOR_DANGER)
			return
		end

		isConnecting = true
		setStatus("CONNECTING", COLOR_WARNING)

		local ok, socket = pcall(connect, CONFIG.wsUrl)
		isConnecting = false

		if not ok or not socket then
			setStatus("FAILED", COLOR_DANGER)
			scheduleReconnect()
			return
		end

		websocket = socket
		connections = {}

		connections[#connections + 1] = websocket.OnMessage:Connect(function(rawMessage)
			local decodedOk, decoded = pcall(function()
				return HttpService:JSONDecode(rawMessage)
			end)

			local isTable

			if decodedOk then
				isTable = type(decoded) == "table"
			else
				isTable = decodedOk
			end

			if isTable then
				local handledOk, handlerError = pcall(handleMessage, decoded)

				if not handledOk then
					warn("[AceFinder] handler error: " .. tostring(handlerError))
				end
			end
		end)

		connections[#connections + 1] = websocket.OnClose:Connect(function()
			isConnected = false
			isIdentified = false
			websocket = nil
			connections = {}
			setStatus("OFFLINE", COLOR_TEXT_SECONDARY, Color3.fromRGB(90, 90, 96))
			scheduleReconnect()
		end)

		sendMessage({
			type = "identify",
			token = CONFIG.wsToken,
			name = localPlayer.Name,
			displayName = localPlayer.DisplayName,
			userId = localPlayer.UserId,
		})
	end

	scheduleReconnect = function()
		if not isCurrentRun() or not screenGui.Parent then
			return
		end

		backoff = math.min(CONFIG.backoffMax, backoff * 2)
		local delaySeconds = math.max(CONFIG.backoffMin, backoff + backoff * 0.2 * (math.random() * 2 - 1))

		setStatus(string.format("RETRY %ds", math.ceil(delaySeconds)), COLOR_WARNING)
		task.delay(delaySeconds, attemptConnect)
	end

	task.spawn(function()
		while screenGui.Parent and isCurrentRun() do
			task.wait(CONFIG.pingEvery)

			if isConnected and websocket then
				lastPingTime = os.clock()
				sendMessage({ type = "ping", ts = lastPingTime })
			end
		end
	end)

	screenGui.Destroying:Connect(function()
		isConnected = false
		closeBrainrotPicker()

		if websocket then
			pcall(function()
				websocket:Close()
			end)
		end
	end)

	applyTheme()
	updateMinimizedVisibility()
	task.spawn(attemptConnect)
end

