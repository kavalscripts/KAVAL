do
	local IGNORED_PLOT_MODELS = {
		Model = true,
		FriendPanel = true,
		CashPad = true,
		PlotSign = true,
	}

	local function parseGenerationRate(text)
		if not text then
			return 0
		end

		local cleaned = text:lower():gsub("%$", ""):gsub("/s", ""):gsub("[%s,]", "")
		local value = tonumber(cleaned:match("[%d%.]+")) or 0

		if cleaned:find("k") then
			value *= 1000
		elseif cleaned:find("m") then
			value *= 1000000
		elseif cleaned:find("b") then
			value *= 1e9
		elseif cleaned:find("t") then
			value *= 1e12
		end

		return math.floor(value)
	end

	function GameBridge.ScanInventory()
		local myPlot = GameBridge.MyPlot()

		if not myPlot then
			return nil, "plot not found"
		end

		local candidates = {}

		for _, child in ipairs(myPlot:GetChildren()) do
			if child:IsA("Model") and not IGNORED_PLOT_MODELS[child.Name] then
				local primaryPart = child.PrimaryPart or child:FindFirstChildWhichIsA("BasePart", true)

				if primaryPart then
					table.insert(candidates, {
						obj = child,
						pos = primaryPart.Position,
						taken = false,
					})
				end
			end
		end

		if #candidates == 0 then
			return {}, nil
		end

		local debris = workspace:FindFirstChild("Debris")

		if not debris then
			return {}, "workspace.Debris missing"
		end

		local inventory = {}

		for _, child in ipairs(debris:GetChildren()) do
			if child.Name == "FastOverheadTemplate" and child:IsA("BasePart") then
				local overhead = child:FindFirstChild("AnimalOverhead")
				local displayNameLabel = overhead and overhead:FindFirstChild("DisplayName")

				if displayNameLabel and displayNameLabel.Text ~= "" then
					local name = displayNameLabel.Text
					local bestDistance = nil
					local bestCandidate = nil

					for _, candidate in ipairs(candidates) do
						if not candidate.taken and candidate.obj.Name == name then
							local distance = (child.Position - candidate.pos).Magnitude

							if distance <= CONFIG.matchRadius and (not bestDistance or distance < bestDistance) then
								bestDistance = distance
								bestCandidate = candidate
							end
						end
					end

					if bestCandidate then
						bestCandidate.taken = true

						local function getLabelText(labelName)
							local label = overhead:FindFirstChild(labelName)
							return label and label.Text ~= "" and label.Text or ""
						end

						local mutationAttribute = bestCandidate.obj:GetAttribute("Mutation") or bestCandidate.obj:GetAttribute("__mutation")
						local mutation = ""

						if mutationAttribute and tostring(mutationAttribute) ~= "" and tostring(mutationAttribute) ~= "None" then
							mutation = tostring(mutationAttribute)
						else
							local mutationLabel = overhead:FindFirstChild("Mutation")
							local hasLabel = mutationLabel and mutationLabel.Visible and mutationLabel.Text ~= "" and mutationLabel.Text ~= "None"

							if hasLabel then
								mutation = mutationLabel.Text
							end
						end

						local traits = {}

						for _, modelChild in ipairs(bestCandidate.obj:GetChildren()) do
							local traitName = modelChild.Name:match("^_Trait%.(.+)$")

							if traitName then
								table.insert(traits, traitName)
							end
						end

						table.sort(traits)

						local generationText = getLabelText("Generation")

						table.insert(inventory, {
							name = name,
							genText = generationText,
							genValue = parseGenerationRate(generationText),
							mutation = mutation,
							rarity = getLabelText("Rarity"),
							traits = table.concat(traits, ", "),
							model = bestCandidate.obj,
						})
					end
				end
			end
		end

		table.sort(inventory, function(a, b)
			return a.genValue > b.genValue
		end)

		return inventory, nil
	end
end

